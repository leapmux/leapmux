#!/command/with-contenv sh
set -eu

mode="${LEAPMUX_MODE:-}"
case "$mode" in
hub|worker|dev|solo) ;;
*)
	echo "error: LEAPMUX_MODE must be one of: hub, worker, dev, solo" >&2
	exit 1
	;;
esac

data_dir="${LEAPMUX_DATA_DIR:-/data}"
bin="${LEAPMUX_BIN:-/usr/local/bin/leapmux}"
config="${data_dir}/${mode}/${mode}.yaml"
mkdir -p "$(dirname "$config")"
if [ ! -e "$config" ]; then
	# Exclusive creation prevents another startup from overwriting this file.
	(umask 077; set -C; : > "$config")
fi
if [ ! -f "$config" ]; then
	printf 'error: configuration path is not a regular file: %s\n' "$config" >&2
	exit 1
fi
exec "$bin" "$mode" -config "$config"
