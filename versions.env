# Centralized tool and image versions. This file is sourced by shell
# scripts, loaded into GitHub Actions via `$GITHUB_ENV`, and exposed to
# Taskfile.yaml via its `dotenv:` directive. Keep entries as plain
# KEY=VALUE lines (UPPER_SNAKE) so every consumer — bash, PowerShell,
# Dockerfile ARGs, Taskfile templates — can read them without a parser.
#
# The places that CANNOT source a file — prose in README.md and the docs
# site, and the `go` directive in each go.mod — are rewritten from here by
# `task sync-versions`, and `task lint` fails if one drifts. After editing
# a value below, run `task sync-versions`.

VERSION=0.0.1-dev

ALPINE_IMAGE=alpine:3.24
UBUNTU_IMAGE=ubuntu:24.04

BUN_VERSION=1.3.14
BUF_VERSION=1.72.0
GOLANG_VERSION=1.26.5
NODE_VERSION=24.19.0
RUST_VERSION=1.97.1
S6_OVERLAY_VERSION=3.2.3.2
TASK_VERSION=3.52.0
WRANGLER_VERSION=4.119.0
