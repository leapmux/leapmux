# Tool and image versions for shell scripts, GitHub Actions, Docker, and Task.
# Keep entries as plain UPPER_SNAKE=VALUE lines so each consumer can read them directly.
# Run task sync-versions after changing a value.
# The sync task updates documented versions and Go directives. The lint task checks these copies.

VERSION=0.0.1-dev

# renovate: datasource=docker depName=alpine versioning=docker
ALPINE_IMAGE=alpine:3.24
# renovate: datasource=docker depName=ubuntu versioning=docker
UBUNTU_IMAGE=ubuntu:26.04

# The images that task test-reverse-proxies runs to verify the reverse proxy
# examples of the documentation. Each pin is an exact release, so that a run
# states which proxy versions the examples work with.
# renovate: datasource=docker depName=nginx versioning=docker
NGINX_IMAGE=nginx:1.29.8-alpine
# renovate: datasource=docker depName=caddy versioning=docker
CADDY_IMAGE=caddy:2.11.9-alpine
# renovate: datasource=docker depName=traefik versioning=docker
TRAEFIK_IMAGE=traefik:3.7.17
# renovate: datasource=docker depName=haproxy versioning=docker
HAPROXY_IMAGE=haproxy:3.4.7-alpine
# renovate: datasource=docker depName=httpd versioning=docker
HTTPD_IMAGE=httpd:2.4.69-alpine
# renovate: datasource=docker depName=curlimages/curl versioning=docker
CURL_IMAGE=curlimages/curl:8.23.0

# GitHub-hosted runner images of the workflow jobs, as the versions in their
# labels: ubuntu-<UBUNTU_RUNNER>, macos-<MACOS_RUNNER>, windows-<WINDOWS_RUNNER>.
# GitHub evaluates runs-on before a step can read this file, so task
# sync-versions writes each label into the workflows. The compiled caches are
# keyed by the image, so a change rebuilds them once.
# renovate: datasource=github-runners depName=ubuntu
UBUNTU_RUNNER=24.04
# renovate: datasource=github-runners depName=macos
MACOS_RUNNER=26
# renovate: datasource=github-runners depName=windows
WINDOWS_RUNNER=2025-vs2026

# renovate: datasource=github-releases depName=oven-sh/bun extractVersion=^bun-v(?<version>.+)$
BUN_VERSION=1.4.4
# renovate: datasource=github-releases depName=bufbuild/buf
BUF_VERSION=1.75.0
# renovate: datasource=golang-version depName=go
GOLANG_VERSION=1.27.4
# renovate: datasource=node-version depName=node
NODE_VERSION=26.13.0
# renovate: datasource=github-releases depName=protocolbuffers/protobuf versioning=loose
PROTOC_VERSION=36.2
# renovate: datasource=rust-version depName=rust
RUST_VERSION=1.99.1
# renovate: datasource=github-releases depName=just-containers/s6-overlay versioning=loose
S6_OVERLAY_VERSION=3.2.3.2
# renovate: datasource=github-releases depName=go-task/task
TASK_VERSION=3.54.0
