# Tool and image versions for shell scripts, GitHub Actions, Docker, and Task.
# Keep entries as plain UPPER_SNAKE=VALUE lines so each consumer can read them directly.
# Run task sync-versions after changing a value.
# The sync task updates documented versions and Go directives. The lint task checks these copies.

VERSION=0.0.1-dev

ALPINE_IMAGE=alpine:3.24
UBUNTU_IMAGE=ubuntu:24.04

BUN_VERSION=1.4.0
BUF_VERSION=1.72.0
GOLANG_VERSION=1.27.1
NODE_VERSION=24.20.0
NODE_GYP_VERSION=13.0.2
RUST_VERSION=1.98.0
S6_OVERLAY_VERSION=3.2.3.2
TASK_VERSION=3.53.1
WRANGLER_VERSION=4.127.1
