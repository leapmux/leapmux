# Version control
.git/
.gitignore

# Let Go create workspace checksums inside the image.
go.work.sum

# Build artifacts
.task/
leapmux
leapmux.exe
leapmux-desktop
leapmux-desktop-service-*
LeapMux*.app/
LeapMux*.dmg
leapmux-desktop*.deb
leapmux-desktop*.AppImage
LeapMux*.msi
backend/leapmux
*.db
*.db-journal
*.db-wal
*.db-shm

# Generated code (rebuilt in Docker)
generated/
*/generated/
*/*/generated/

# Frontend build artifacts (rebuilt in Docker)
frontend/.output/
frontend/.vinxi/

# Local JavaScript dependency installations
**/node_modules/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Test artifacts
.tmp/
frontend/test-results/
frontend/playwright-report/

# Docker files (not needed in build context except rootfs)
docker/Dockerfile

# Desktop app (go.mod/go.sum only: go.work lists ./desktop/go, so workspace
# mode needs that module's manifests. The Docker build downloads the module
# set through the cache mount, not through a copied layer.)
desktop/
!desktop/go/go.mod
!desktop/go/go.sum

# Misc
.DS_Store
*.log
mprocs.yaml
