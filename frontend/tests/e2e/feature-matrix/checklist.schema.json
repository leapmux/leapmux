{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coding-agent provider feature checklist",
  "type": "object",
  "additionalProperties": false,
  "required": ["_readme", "supportStates", "providerGroups", "cells"],
  "properties": {
    "_readme": { "type": "string", "minLength": 1 },
    "supportStates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/supportState" }
    },
    "providerGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10,
        "items": { "$ref": "#/$defs/provider" }
      }
    },
    "cells": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": { "$ref": "#/$defs/id" },
        "additionalProperties": { "$ref": "#/$defs/cell" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "supportId": { "enum": ["supported", "agent-limit", "leapmux-limit"] },
    "supportState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "symbol", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/supportId" },
        "symbol": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "userNote": { "type": "string", "maxLength": 400, "pattern": "^[^\\n]*$" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "url", "icon", "userNote", "detailNote"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "icon": { "type": "string", "pattern": "^/icons/agents/[a-z0-9-]+\\.svg$" },
        "userNote": { "$ref": "#/$defs/userNote" },
        "detailNote": { "type": "string" }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support", "userNote", "detailNote", "spec", "audit", "verified", "testStatus"],
      "allOf": [
        {
          "if": { "properties": { "testStatus": { "const": "passed" } } },
          "then": { "properties": { "spec": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "support": { "const": "supported" } } },
          "then": {
            "properties": {
              "audit": { "enum": ["covered", "existing-e2e-mapped", "source-verified"] }
            }
          },
          "else": {
            "properties": {
              "audit": { "enum": ["unsupported", "refusal-covered", "covered-negative"] }
            }
          }
        }
      ],
      "properties": {
        "support": { "$ref": "#/$defs/supportId" },
        "userNote": { "$ref": "#/$defs/userNote" },
        "detailNote": { "type": "string" },
        "spec": {
          "type": "string",
          "pattern": "^(?:frontend/tests/e2e/(?:[a-z0-9-]+/)*[a-z0-9-]+\\.spec\\.ts)?$"
        },
        "audit": {
          "type": "string",
          "enum": ["covered", "unsupported", "existing-e2e-mapped", "refusal-covered", "covered-negative", "source-verified"]
        },
        "verified": { "type": "boolean" },
        "testStatus": { "type": "string", "enum": ["pending", "passed"] }
      }
    }
  }
}
