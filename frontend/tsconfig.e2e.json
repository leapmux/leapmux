{
  // Playwright specs require Playwright and Node types.
  // Keep this project separate from the Vitest types in the main configuration.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/tsc/e2e.tsbuildinfo",
    "types": ["@playwright/test", "node"]
  },
  "include": ["tests/e2e"],
  // The main configuration owns co-located unit tests. This follows the runner split by file extension.
  "exclude": ["tests/e2e/**/*.test.ts"]
}
