{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/frontend.tsbuildinfo",
    "target": "ES2021",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "~/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "types": ["vinxi/types/client", "vitest/globals", "@testing-library/jest-dom"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "allowUnreachableCode": false,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "strictBuiltinIteratorReturn": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  // The typecheck program needs an old-space heap beyond Node's ~2GB default
  // on the smallest CI runner (the macOS M1), so package.json runs tsc through
  // node --max-old-space-size=4096. Keep that flag in place while this include
  // list covers the whole frontend, its scripts and the e2e helpers.
  // resolve.tsconfigPaths enables aliases only for importers in this include list.
  // Include configuration and setup files so their aliases resolve before any test loads.
  // Co-located helper tests belong to Vitest. tsconfig.e2e.json owns the adjacent Playwright specs.
  "include": ["src", "app.config.ts", "playwright.config*.ts", "vitest*.ts", "eslint/**/*.ts", "scripts/**/*.ts", "tests/e2e/**/*.test.ts"]
}
