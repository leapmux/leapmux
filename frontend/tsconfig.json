{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/frontend.tsbuildinfo",
    "target": "ES2021",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "~/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "types": ["vinxi/types/client", "vitest/globals", "@testing-library/jest-dom"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  // resolve.tsconfigPaths enables aliases only for importers in this include list.
  // Include configuration and setup files so their aliases resolve before any test loads.
  // Co-located helper tests belong to Vitest. tsconfig.e2e.json owns the adjacent Playwright specs.
  "include": ["src", "app.config.ts", "vitest*.ts", "scripts/**/*.ts", "tests/e2e/**/*.test.ts"]
}
