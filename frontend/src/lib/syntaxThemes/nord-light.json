{
  "name": "nord-light",
  "type": "light",
  "colors": {
    "editor.background": "#eceff4",
    "editor.foreground": "#2e3440",
    "terminal.ansiBlack": "#3b4252",
    "terminal.ansiRed": "#bf616a",
    "terminal.ansiGreen": "#96b17f",
    "terminal.ansiYellow": "#c5a565",
    "terminal.ansiBlue": "#81a1c1",
    "terminal.ansiMagenta": "#b48ead",
    "terminal.ansiCyan": "#7bb3c3",
    "terminal.ansiWhite": "#a5abb6",
    "terminal.ansiBrightBlack": "#4c566a",
    "terminal.ansiBrightRed": "#bf616a",
    "terminal.ansiBrightGreen": "#96b17f",
    "terminal.ansiBrightYellow": "#c5a565",
    "terminal.ansiBrightBlue": "#81a1c1",
    "terminal.ansiBrightMagenta": "#b48ead",
    "terminal.ansiBrightCyan": "#82afae",
    "terminal.ansiBrightWhite": "#eceff4"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#4c566a"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "variable.language"
      ],
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "scope": [
        "entity",
        "entity.name"
      ],
      "settings": {
        "foreground": "#b48ead"
      }
    },
    {
      "scope": "variable.parameter.function",
      "settings": {
        "foreground": "#2e3440"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#96b17f"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#bf616a"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#bf616a"
      }
    },
    {
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#2e3440"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string punctuation.section.embedded source"
      ],
      "settings": {
        "foreground": "#96b17f"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "scope": "meta.property-name",
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#c5a565"
      }
    },
    {
      "scope": "variable.other",
      "settings": {
        "foreground": "#2e3440"
      }
    },
    {
      "scope": "invalid.broken",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#bf616a"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#bf616a"
      }
    },
    {
      "scope": "invalid.illegal",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#bf616a"
      }
    },
    {
      "scope": "invalid.unimplemented",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#bf616a"
      }
    },
    {
      "scope": "carriage-return",
      "settings": {
        "background": "#bf616a",
        "content": "^M",
        "fontStyle": "italic underline",
        "foreground": "#eceff4"
      }
    },
    {
      "scope": "message.error",
      "settings": {
        "foreground": "#bf616a"
      }
    },
    {
      "scope": "string variable",
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "scope": [
        "source.regexp",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#96b17f"
      }
    },
    {
      "scope": [
        "string.regexp.character-class",
        "string.regexp constant.character.escape",
        "string.regexp source.ruby.embedded",
        "string.regexp string.regexp.arbitrary-repitition"
      ],
      "settings": {
        "foreground": "#96b17f"
      }
    },
    {
      "scope": "string.regexp constant.character.escape",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#96b17f"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "scope": "support.variable",
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "scope": "meta.module-reference",
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "scope": "punctuation.definition.list.begin.markdown",
      "settings": {
        "foreground": "#c5a565"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#81a1c1"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#96b17f"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#2e3440"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2e3440"
      }
    },
    {
      "scope": [
        "markup.underline"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "background": "#ffeef0",
        "foreground": "#bf616a"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "background": "#f0fff4",
        "foreground": "#96b17f"
      }
    },
    {
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "background": "#ffebda",
        "foreground": "#c5a565"
      }
    },
    {
      "scope": [
        "markup.ignored",
        "markup.untracked"
      ],
      "settings": {
        "background": "#81a1c1",
        "foreground": "#eceff4"
      }
    },
    {
      "scope": "meta.diff.range",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#b48ead"
      }
    },
    {
      "scope": "meta.diff.header",
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "scope": "meta.separator",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#81a1c1"
      }
    },
    {
      "scope": "meta.output",
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "scope": [
        "brackethighlighter.tag",
        "brackethighlighter.curly",
        "brackethighlighter.round",
        "brackethighlighter.square",
        "brackethighlighter.angle",
        "brackethighlighter.quote"
      ],
      "settings": {
        "foreground": "#4c566a"
      }
    },
    {
      "scope": "brackethighlighter.unmatched",
      "settings": {
        "foreground": "#bf616a"
      }
    },
    {
      "scope": [
        "constant.other.reference.link",
        "string.other.link"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#96b17f"
      }
    }
  ]
}
