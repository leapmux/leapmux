# Cloudflare Workers Static Assets reads this file to set response headers.
#
# Serve plain-text endpoints (llms.txt, llms-small.txt, llms-full.txt, robots.txt)
# and Markdown endpoints (agent-guide.md, /docs/**/index.md, /skills/**/*.md) as
# UTF-8 so browsers and LLM clients never decode UTF-8 punctuation as Latin-1.
# Each wildcard rule is disjoint by extension so Cloudflare never appends
# duplicate Content-Type values or overrides YAML files under /skills/.
/*.txt
  Content-Type: text/plain; charset=utf-8

/*.md
  Content-Type: text/markdown; charset=utf-8
