# Cloudflare Workers Static Assets reads this file to set response headers.
#
# Serve llms.txt and Markdown endpoints as UTF-8 so browsers and LLM clients
# never decode UTF-8 punctuation as Latin-1.
/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-small.txt
  Content-Type: text/plain; charset=utf-8

/agent-guide.md
  Content-Type: text/markdown; charset=utf-8

/*.md
  Content-Type: text/markdown; charset=utf-8

/docs/*
  Vary: Accept

/skills/*
  Content-Type: text/markdown; charset=utf-8
