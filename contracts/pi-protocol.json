  "structs": {
    "PiIncompleteToolSupplement": {
      "doc": "PiIncompleteToolSupplement retains the last partial result when a turn ends before the tool result.",
      "table": "supplement",
      "fields": [
        {
          "key": "ToolCallID",
          "type": "string"
        },
        {
          "key": "ToolName",
          "type": "string"
        },
        {
          "key": "PartialResult",
          "type": "json.RawMessage",
          "omitempty": true
        }
      ]
    },
    "PiToolCallIdentity": {
      "doc": "PiToolCallIdentity keeps both native call identity fields consistent across decoders. Each decoder uses a different Go type for the result.",
      "table": "resultFields",
      "fields": [
        {
          "key": "ToolCallID",
          "type": "string"
        },
        {
          "key": "ToolName",
          "type": "string"
        }
      ]
