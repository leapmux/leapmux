{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codebuddy-protocol.schema.json",
  "title": "CodeBuddy Code stream-json wire vocabulary",
  "description": "Every table is a map from the identifier both languages spell (PascalCase) to the literal CodeBuddy sends or LeapMux chose. A table may never be empty.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_readme", "frameKinds", "controlRequestSubtypes", "modes", "effortLevels", "systemSubtypes"],
  "$defs": {
    "table": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Z][A-Za-z0-9]*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "properties": {
    "_readme": { "type": "string", "minLength": 1 },
    "_unread": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": { "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sides", "why"],
          "properties": {
            "sides": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["go", "ts"] }
            },
            "why": { "type": "string", "minLength": 31 }
          }
        }
      }
    },
    "frameKinds": { "$ref": "#/$defs/table" },
    "controlRequestSubtypes": { "$ref": "#/$defs/table" },
    "modes": { "$ref": "#/$defs/table" },
    "defaultMode": { "type": "string", "minLength": 1 },
    "effortLevels": { "$ref": "#/$defs/table" },
    "systemSubtypes": { "$ref": "#/$defs/table" }
  }
}
