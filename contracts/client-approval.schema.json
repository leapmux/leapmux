{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "client-approval.schema.json",
  "title": "LeapMux client approval option",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_readme",
    "options"
  ],
  "properties": {
    "_readme": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "AutoApprove"
      ],
      "properties": {
        "AutoApprove": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
