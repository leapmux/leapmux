{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external-apps.schema.json",
  "title": "External applications the desktop sidecar can open a directory in",
  "description": "`kinds` maps each non-UNSPECIFIED ExternalAppKind proto enum value to a one-line description, which becomes the doc comment on the generated grouping. `apps` maps each stable id to the kind it is and the operating systems whose spec table must carry it. An id is a lowercase kebab-case token, because it is also the key of the browser's icon table and of the stored default.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_readme", "kinds", "apps"],
  "properties": {
    "_readme": { "type": "string", "minLength": 1 },
    "kinds": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^EXTERNAL_APP_KIND_[A-Z0-9_]+$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "apps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "oses"],
        "properties": {
          "kind": { "type": "string", "pattern": "^EXTERNAL_APP_KIND_[A-Z0-9_]+$" },
          "oses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["darwin", "linux", "windows"] }
          }
        }
      }
    }
  }
}
