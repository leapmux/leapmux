{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "theme-default.schema.json",
  "title": "default palette contract",
  "description": "The default theme's full light/dark token maps plus the OAuth pages' curated subset. The generator checks that every oauthPage token (after renames) exists in BOTH variants, and emits a plain-data TS module (the theme dir imports it by relative path) and the Go pageCSS palette block.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_readme", "light", "dark", "oauthPage"],
  "properties": {
    "_readme": { "type": "string", "minLength": 1 },
    "light": { "$ref": "#/$defs/palette" },
    "dark": { "$ref": "#/$defs/palette" },
    "oauthPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "renames"],
      "properties": {
        "tokens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^--[a-z][a-z0-9-]*$" }
        },
        "renames": {
          "type": "object",
          "propertyNames": { "pattern": "^--[a-z][a-z0-9-]*$" },
          "additionalProperties": { "type": "string", "pattern": "^--[a-z][a-z0-9-]*$" }
        }
      }
    }
  },
  "$defs": {
    "palette": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^--[a-z][a-z0-9-]*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
