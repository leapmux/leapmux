{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codewhale-protocol.schema.json",
  "title": "Codewhale runtime API vocabulary",
  "description": "Each table maps PascalCase identifiers to protocol values. Go constants and TypeScript keys derive from those identifiers. Every table requires at least one value. An empty table supplies no dispatch case and prevents the generator from checking coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_readme",
    "events",
    "itemKinds",
    "turnStatuses",
    "modes",
    "postures",
    "options",
    "toolNames",
    "agentActions",
    "agentInputFields",
    "envelopeFields",
    "itemFields",
    "toolFields",
    "itemMetadata",
    "resultFields",
    "workflowStatuses",
    "turnFields",
    "approvalFields",
    "userInputFields",
    "questionFields",
    "controlPayload",
    "replyFrames",
    "replyFields",
    "decisions",
    "answerFields",
    "answerLabels",
    "answerTexts",
    "transcriptKinds",
    "transcriptFields",
    "transcriptRoles",
    "blockTypes",
    "blockFields",
    "defaultMode",
    "mediaFields",
    "supplementFields",
    "mediaTypes",
    "mediaRules"
  ],
  "$defs": {
    "table": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "unread": {
      "description": "This map states per-key reader exemptions. contractsAreConsumed.test.mjs checks each key on every declared reader side. A key that one side does not consume must state its reason here.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sides",
            "why"
          ],
          "properties": {
            "sides": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "go",
                  "ts"
                ]
              }
            },
            "why": {
              "type": "string",
              "minLength": 31
            }
          }
        }
      }
    }
  },
  "properties": {
    "_readme": {
      "type": "string",
      "minLength": 1
    },
    "_unread": {
      "$ref": "#/$defs/unread"
    },
    "defaultMode": {
      "description": "The key in modes that a fresh Codewhale thread selects. The generator checks that the key exists in modes.",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "events": {
      "$ref": "#/$defs/table"
    },
    "itemKinds": {
      "$ref": "#/$defs/table"
    },
    "turnStatuses": {
      "$ref": "#/$defs/table"
    },
    "modes": {
      "$ref": "#/$defs/table"
    },
    "postures": {
      "$ref": "#/$defs/table"
    },
    "options": {
      "$ref": "#/$defs/table"
    },
    "toolNames": {
      "$ref": "#/$defs/table"
    },
    "agentActions": {
      "$ref": "#/$defs/table"
    },
    "agentInputFields": {
      "$ref": "#/$defs/table"
    },
    "envelopeFields": {
      "$ref": "#/$defs/table"
    },
    "itemFields": {
      "$ref": "#/$defs/table"
    },
    "toolFields": {
      "$ref": "#/$defs/table"
    },
    "itemMetadata": {
      "$ref": "#/$defs/table"
    },
    "resultFields": {
      "$ref": "#/$defs/table"
    },
    "workflowStatuses": {
      "$ref": "#/$defs/table"
    },
    "turnFields": {
      "$ref": "#/$defs/table"
    },
    "approvalFields": {
      "$ref": "#/$defs/table"
    },
    "userInputFields": {
      "$ref": "#/$defs/table"
    },
    "questionFields": {
      "$ref": "#/$defs/table"
    },
    "controlPayload": {
      "$ref": "#/$defs/table"
    },
    "replyFrames": {
      "$ref": "#/$defs/table"
    },
    "replyFields": {
      "$ref": "#/$defs/table"
    },
    "decisions": {
      "$ref": "#/$defs/table"
    },
    "answerFields": {
      "$ref": "#/$defs/table"
    },
    "answerLabels": {
      "$ref": "#/$defs/table"
    },
    "answerTexts": {
      "$ref": "#/$defs/table"
    },
    "transcriptKinds": {
      "$ref": "#/$defs/table"
    },
    "transcriptFields": {
      "$ref": "#/$defs/table"
    },
    "transcriptRoles": {
      "$ref": "#/$defs/table"
    },
    "blockTypes": {
      "$ref": "#/$defs/table"
    },
    "blockFields": {
      "$ref": "#/$defs/table"
    },
    "mediaFields": {
      "$ref": "#/$defs/table"
    },
    "supplementFields": {
      "$ref": "#/$defs/table"
    },
    "mediaTypes": {
      "$ref": "#/$defs/table"
    },
    "mediaRules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "required": [
        "CurrentVersion",
        "MaxImageBytes",
        "MaxDimension",
        "MaxPixels"
      ],
      "properties": {
        "CurrentVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "MaxImageBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "MaxDimension": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "MaxPixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
