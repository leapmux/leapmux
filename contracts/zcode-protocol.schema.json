{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zcode-protocol.schema.json",
  "title": "ZCode app-server wire vocabulary",
  "description": "Every table is a map from the identifier both languages spell (PascalCase, so the Go constant and the TS key derive from one name) to the literal the app-server sends. A table may never be empty: an empty one would emit an enum no dispatch can match, and the generator's own coverage check would have nothing to compare.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_readme",
    "events",
    "toolPrefixes",
    "methods",
    "actions",
    "replyFields",
    "answerFields",
    "planControls",
    "interactions",
    "toolKinds",
    "toolNames",
    "modes",
    "resultTypes",
    "decisions",
    "supplement",
    "supplementPayload",
    "storedTool",
    "storedPart",
    "storedPartTypes",
    "defaultMode",
    "storedAttachment",
    "storedAttachmentTypes",
    "storedPartStatuses"
  ],
  "$defs": {
    "table": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "structs": {
      "description": "Go structs generated from this domain. Each states its field list once and takes every json tag from a named table, so a rename in the table reaches the struct.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "table",
          "fields"
        ],
        "properties": {
          "doc": {
            "type": "string",
            "minLength": 1
          },
          "table": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "type"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Za-z0-9]*$"
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "omitempty": {
                  "type": "boolean"
                },
                "table": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "unread": {
      "description": "The per-key exemptions this domain states. `contractsAreConsumed.test.mjs` holds every KEY of a table to a reader on each side the table declares. A key one side genuinely never reads states that here: `_unread.<table>.<Key>.sides` lists the sides that skip it, and `.why` says what reads it instead. The key stays in the contract, because the other side still reads it and a rename must still reach that side. An exemption the code no longer needs fails the same test, so a stale one cannot survive.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sides",
            "why"
          ],
          "properties": {
            "sides": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "go",
                  "ts"
                ]
              }
            },
            "why": {
              "type": "string",
              "minLength": 31
            }
          }
        }
      }
    }
  },
  "properties": {
    "_readme": {
      "type": "string",
      "minLength": 1
    },
    "_unread": {
      "$ref": "#/$defs/unread"
    },
    "events": {
      "$ref": "#/$defs/table"
    },
    "toolPrefixes": {
      "$ref": "#/$defs/table"
    },
    "methods": {
      "$ref": "#/$defs/table"
    },
    "actions": {
      "$ref": "#/$defs/table"
    },
    "replyFields": {
      "$ref": "#/$defs/table"
    },
    "answerFields": {
      "$ref": "#/$defs/table"
    },
    "planControls": {
      "$ref": "#/$defs/table"
    },
    "interactions": {
      "$ref": "#/$defs/table"
    },
    "toolKinds": {
      "$ref": "#/$defs/table"
    },
    "toolNames": {
      "$ref": "#/$defs/table"
    },
    "modes": {
      "$ref": "#/$defs/table"
    },
    "resultTypes": {
      "$ref": "#/$defs/table"
    },
    "decisions": {
      "$ref": "#/$defs/table"
    },
    "supplement": {
      "$ref": "#/$defs/table"
    },
    "supplementPayload": {
      "$ref": "#/$defs/table"
    },
    "storedTool": {
      "$ref": "#/$defs/table"
    },
    "storedPart": {
      "$ref": "#/$defs/table"
    },
    "storedPartTypes": {
      "$ref": "#/$defs/table"
    },
    "defaultMode": {
      "description": "The key in `modes` a fresh ZCode session runs on. A key, not a literal, so it cannot name a mode the table does not carry -- the generator checks the membership.",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "storedAttachment": {
      "$ref": "#/$defs/table"
    },
    "storedAttachmentTypes": {
      "$ref": "#/$defs/table"
    },
    "storedPartStatuses": {
      "$ref": "#/$defs/table"
    },
    "structs": {
      "$ref": "#/$defs/structs"
    }
  }
}
