{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "copilot-protocol.schema.json",
  "title": "Copilot native tool vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": ["_readme", "events", "tools", "supplement"],
  "$defs": {
    "table": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Z][A-Za-z0-9]*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "properties": {
    "_readme": { "type": "string", "minLength": 1 },
    "events": { "$ref": "#/$defs/table" },
    "tools": { "$ref": "#/$defs/table" },
    "supplement": { "$ref": "#/$defs/table" }
  }
}
