  "structs": {
    "CodexToolSupplement": {
      "doc": "CodexToolSupplement stores the output that LeapMux joined for an incomplete typed tool call. The item identity keeps the supplement on its original row.",
      "table": "supplement",
      "fields": [
        {
          "key": "ItemID",
          "type": "string"
        },
        {
          "key": "ItemType",
          "type": "string"
        },
        {
          "key": "AggregatedOutput",
          "type": "string"
        }
      ]
    },
    "CodexRawExecutionItem": {
      "doc": "CodexRawExecutionItem reads native exec identity and payload fields. A nullable input distinguishes an empty script from missing source.",
      "table": "rawFields",
      "fields": [
        {
          "key": "Type",
          "type": "string"
        },
        {
          "key": "CallID",
          "type": "string"
        },
        {
          "key": "Name",
          "type": "string"
        },
        {
          "key": "Namespace",
          "type": "string"
        },
        {
          "key": "Input",
          "type": "*string"
        },
        {
          "key": "Output",
          "type": "json.RawMessage"
        }
      ]
    },
    "CodexRawExecutionParams": {
      "doc": "CodexRawExecutionParams identifies the native thread and turn of one raw response item. The item remains raw until its type is known.",
      "table": "rawFields",
      "fields": [
        {
          "key": "ThreadID",
          "type": "string"
        },
        {
          "key": "TurnID",
          "type": "string"
        },
        {
          "key": "Item",
          "type": "json.RawMessage"
        }
      ]
    }
  },
