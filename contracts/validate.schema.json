{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validate.schema.json",
  "title": "validation policy parameter contract",
  "description": "Byte limits and character classes shared by the Go validators and the browser's validate.ts. Each range is a [lo, hi, name] triple -- inclusive code points plus the character name(s), which the generator emits as a trailing comment in the Go tables and ignores on the TS side. The name is REQUIRED: a bare number pair is the unreadable shape this schema exists to prevent. The generator checks the pairs are sorted, non-overlapping, and within the Unicode range, and emits Go unicode.RangeTables / rune sets and TS regex class sources, and the reserved-username sets (username -> why; the generator emits Go consts + lookup sets and TS arrays).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_readme",
    "name",
    "session",
    "password",
    "branch",
    "usernames"
  ],
  "properties": {
    "_readme": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteLimit",
        "invisibleFormat",
        "whitespaceFold"
      ],
      "properties": {
        "byteLimit": {
          "type": "integer",
          "minimum": 1
        },
        "invisibleFormat": {
          "$ref": "#/$defs/ranges"
        },
        "whitespaceFold": {
          "$ref": "#/$defs/ranges"
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteLimit",
        "filePathByteLimit",
        "invisibleFormat",
        "refusedControl",
        "refusedAscii"
      ],
      "properties": {
        "byteLimit": {
          "type": "integer",
          "minimum": 1
        },
        "filePathByteLimit": {
          "type": "integer",
          "minimum": 1
        },
        "invisibleFormat": {
          "$ref": "#/$defs/ranges"
        },
        "refusedControl": {
          "$ref": "#/$defs/ranges"
        },
        "refusedAscii": {
          "$ref": "#/$defs/ranges"
        }
      }
    },
    "password": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minLength",
        "maxLength",
        "printableAsciiMin",
        "printableAsciiMax"
      ],
      "properties": {
        "minLength": {
          "type": "integer",
          "minimum": 1
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1
        },
        "printableAsciiMin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "printableAsciiMax": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteLimit",
        "refusedControl",
        "refusedAscii"
      ],
      "properties": {
        "byteLimit": {
          "type": "integer",
          "minimum": 1
        },
        "refusedControl": {
          "$ref": "#/$defs/ranges"
        },
        "refusedAscii": {
          "$ref": "#/$defs/ranges"
        }
      }
    },
    "usernames": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systemReserved",
        "publicReserved"
      ],
      "properties": {
        "systemReserved": {
          "$ref": "#/$defs/reservedUsernames"
        },
        "publicReserved": {
          "$ref": "#/$defs/reservedUsernames"
        }
      }
    }
  },
  "$defs": {
    "reservedUsernames": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 1114111
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 1114111
          },
          {
            "type": "string",
            "minLength": 1
          }
        ],
        "items": false
      }
    }
  }
}
