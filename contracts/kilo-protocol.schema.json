{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kilo-protocol.schema.json",
  "title": "Kilo native protocol vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_readme",
    "events",
    "statusTypes",
    "audioMimeTypes"
  ],
  "properties": {
    "_readme": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SessionStatus",
        "SessionCompacted"
      ],
      "properties": {
        "SessionStatus": {
          "type": "string",
          "minLength": 1
        },
        "SessionCompacted": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "statusTypes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Retry"
      ],
      "properties": {
        "Retry": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "audioMimeTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      }
    }
  }
}
