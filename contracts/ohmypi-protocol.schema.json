{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ohmypi-protocol.schema.json",
  "title": "Oh My Pi RPC wire vocabulary",
  "description": "Each table maps PascalCase identifiers to protocol values. Go constants and TypeScript keys derive from those identifiers. Every table requires at least one value. An empty table supplies no dispatch case and prevents the generator from checking coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_readme",
    "events",
    "assistantEvents",
    "messageRoles",
    "stopReasons",
    "dialogMethods",
    "extensionMethods",
    "toolNames",
    "todoStatuses",
    "approvalModes",
    "dialogResponse",
    "approvalDialog",
    "frameFields",
    "askQuestion",
    "askOption",
    "askTypes",
    "askEnvelope",
    "askAnswer",
    "supplement",
    "customTypes",
    "commands",
    "asyncJobStates",
    "structs"
  ],
  "$defs": {
    "table": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "structs": {
      "description": "Go structs generated from this domain. Each states its field list once and takes every json tag from a named table, so a rename in the table reaches the struct.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "table",
          "fields"
        ],
        "properties": {
          "doc": {
            "type": "string",
            "minLength": 1
          },
          "table": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "type"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Za-z0-9]*$"
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "omitempty": {
                  "type": "boolean"
                },
                "table": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "unread": {
      "description": "This map states per-key reader exemptions. contractsAreConsumed.test.mjs checks each key on every declared reader side. A key that one side does not consume must state its reason here.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sides",
            "why"
          ],
          "properties": {
            "sides": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "go",
                  "ts"
                ]
              }
            },
            "why": {
              "type": "string",
              "minLength": 31
            }
          }
        }
      }
    }
  },
  "properties": {
    "_readme": {
      "type": "string",
      "minLength": 1
    },
    "_unread": {
      "$ref": "#/$defs/unread"
    },
    "events": {
      "$ref": "#/$defs/table"
    },
    "assistantEvents": {
      "$ref": "#/$defs/table"
    },
    "messageRoles": {
      "$ref": "#/$defs/table"
    },
    "stopReasons": {
      "$ref": "#/$defs/table"
    },
    "dialogMethods": {
      "$ref": "#/$defs/table"
    },
    "extensionMethods": {
      "$ref": "#/$defs/table"
    },
    "toolNames": {
      "$ref": "#/$defs/table"
    },
    "todoStatuses": {
      "$ref": "#/$defs/table"
    },
    "approvalModes": {
      "$ref": "#/$defs/table"
    },
    "dialogResponse": {
      "$ref": "#/$defs/table"
    },
    "approvalDialog": {
      "$ref": "#/$defs/table"
    },
    "frameFields": {
      "$ref": "#/$defs/table"
    },
    "askQuestion": {
      "$ref": "#/$defs/table"
    },
    "askOption": {
      "$ref": "#/$defs/table"
    },
    "askTypes": {
      "$ref": "#/$defs/table"
    },
    "askEnvelope": {
      "$ref": "#/$defs/table"
    },
    "askAnswer": {
      "$ref": "#/$defs/table"
    },
    "supplement": {
      "$ref": "#/$defs/table"
    },
    "customTypes": {
      "$ref": "#/$defs/table"
    },
    "commands": {
      "$ref": "#/$defs/table"
    },
    "asyncJobStates": {
      "$ref": "#/$defs/table"
    },
    "structs": {
      "$ref": "#/$defs/structs"
    }
  }
}
