  "structs": {
    "KimiApprovalReply": {
      "doc": "KimiApprovalReply is the body that answers one approval, as the worker stores it.\n\nThe worker posts it to `/sessions/{id}/approvals/{approval_id}` without\n`permission_mode`, which is LeapMux's own: it states the mode an approved plan\nor goal start switches to, and the worker applies it before it posts the\ndecision. The browser\nreads the stored reply back to word the saved answer.",
      "table": "reply",
      "fields": [
        {
          "key": "Decision",
          "type": "string"
        },
        {
          "key": "Scope",
          "type": "string",
          "omitempty": true
        },
        {
          "key": "Feedback",
          "type": "string",
          "omitempty": true
        },
        {
          "key": "SelectedLabel",
          "type": "string",
          "omitempty": true
        },
        {
          "key": "PermissionMode",
          "type": "string",
          "omitempty": true
        }
      ]
    },
    "KimiQuestionReply": {
      "doc": "KimiQuestionReply is the body that answers one question, as the worker stores it.\n\n`Dismiss` is LeapMux's own mark: the server takes a dismissal through its own\n`:dismiss` route with no body, so a stored reply that sets it carries no answers.",
      "table": "reply",
      "fields": [
        {
          "key": "Answers",
          "type": "json.RawMessage",
          "omitempty": true
        },
        {
          "key": "Method",
          "type": "string",
          "omitempty": true
        },
        {
          "key": "Dismiss",
          "type": "bool",
          "omitempty": true
        }
      ]
    },
    "KimiDecisionFields": {
      "doc": "KimiDecisionFields are the fields the browser writes beside the neutral\n`behavior` of its answer: the approval scope, and a question's answers in the\nserver's own shape.",
      "table": "reply",
      "fields": [
        {
          "key": "Scope",
          "type": "string",
          "omitempty": true
        },
        {
          "key": "Answers",
          "type": "json.RawMessage",
          "omitempty": true
        }
      ]
    }
  },
  "_unread": {
    "reply": {
      "Method": {
        "sides": [
          "ts"
        ],
        "why": "the worker stamps the answer method itself when it builds the question body; the browser writes the answers alone and words the saved answer from them"
      },
      "PermissionMode": {
        "sides": [
          "ts"
        ],
        "why": "the worker writes the permission mode an approved plan switches to and applies it before it posts the decision; the browser reads the mode from the plan approval settings that the service stores beside the answer"
      }
    }
  }
