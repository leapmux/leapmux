{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-protocol.schema.json",
  "title": "Codex item wire vocabulary",
  "description": "Each nonempty table maps a shared identifier to its native Codex value. Generated Go and TypeScript names derive from that identifier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_readme",
    "supplement",
    "item",
    "collabItem",
    "itemTypes",
    "methods",
    "options",
    "optionDefaults",
    "rawItems",
    "rawTools",
    "rawFields",
    "rawNamespaces",
    "executables"
  ],
  "$defs": {
    "table": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "structs": {
      "description": "Generated Go structs use table values for their JSON tags. Each struct defines its field list once.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "table",
          "fields"
        ],
        "properties": {
          "doc": {
            "type": "string",
            "minLength": 1
          },
          "table": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "type"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Za-z0-9]*$"
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "omitempty": {
                  "type": "boolean"
                },
                "table": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "unread": {
      "description": "A key that one language does not read records that exception here. Each exception states the language and its reason. The contract-consumption test rejects stale exceptions.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sides",
            "why"
          ],
          "properties": {
            "sides": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "go",
                  "ts"
                ]
              }
            },
            "why": {
              "type": "string",
              "minLength": 31
            }
          }
        }
      }
    }
  },
  "properties": {
    "_readme": {
      "type": "string",
      "minLength": 1
    },
    "_unread": {
      "$ref": "#/$defs/unread"
    },
    "supplement": {
      "$ref": "#/$defs/table"
    },
    "item": {
      "$ref": "#/$defs/table"
    },
    "collabItem": {
      "$ref": "#/$defs/table"
    },
    "structs": {
      "$ref": "#/$defs/structs"
    },
    "itemTypes": {
      "$ref": "#/$defs/table"
    },
    "methods": {
      "$ref": "#/$defs/table"
    },
    "options": {
      "$ref": "#/$defs/table"
    },
    "optionDefaults": {
      "$ref": "#/$defs/table"
    },
    "rawItems": {
      "$ref": "#/$defs/table"
    },
    "rawTools": {
      "$ref": "#/$defs/table"
    },
    "rawFields": {
      "$ref": "#/$defs/table"
    },
    "rawNamespaces": {
      "$ref": "#/$defs/table"
    },
    "executables": {
      "$ref": "#/$defs/table"
    }
  }
}
