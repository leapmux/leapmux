{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-vocab.schema.json",
  "title": "worker wire vocabulary contract",
  "description": "This contract supplies the notification vocabulary and the model sentinels. The generator checks that each workerWrittenNotificationTypes entry identifies a notificationTypes key. It also requires unique tokens. goalStatusTokens supplies the goal status vocabulary for payloads, including Unknown. The agents.goal_status column stores the AgentGoalStatus ordinal. goalTransitions states the goal change, including an Updated transition with no known neutral status meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_readme",
    "notificationTypes",
    "goalStatusTokens",
    "goalTransitions",
    "workerWrittenNotificationTypes",
    "assembledMessage",
    "toolOutcome",
    "notificationThreadWrapperType",
    "messageMetadataFields",
    "messageSupplementFields",
    "rpcMethods",
    "codexRateLimitReachedTimeWindow",
    "codexRateLimitAccountBlockKey",
    "modelSentinels",
    "notificationFields",
    "backgroundTaskStatusTokens"
  ],
  "properties": {
    "messageSupplementFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Provider",
        "Metadata"
      ],
      "properties": {
        "Provider": {
          "type": "string",
          "minLength": 1
        },
        "Metadata": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "messageMetadataFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "DurationMs",
        "ToolUses",
        "ControlRequestID",
        "ControlRequestClaimToken",
        "PlanApprovalSettings",
        "ToolOutcome",
        "TodoSnapshot"
      ],
      "properties": {
        "DurationMs": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "ToolUses": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "ControlRequestID": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "ControlRequestClaimToken": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "PlanApprovalSettings": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "ToolOutcome": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "TodoSnapshot": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "rpcMethods": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      }
    },
    "_readme": {
      "type": "string",
      "minLength": 1
    },
    "codexRateLimitAccountBlockKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "notificationTypes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "goalStatusTokens": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z][a-z0-9_]*)?$"
      }
    },
    "goalTransitions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "workerWrittenNotificationTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      }
    },
    "assembledMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "types",
        "kinds",
        "completions"
      ],
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Type",
            "Kind",
            "Text",
            "Completion"
          ],
          "properties": {
            "Type": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "Kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "Text": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "Completion": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "types": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Assembled"
          ],
          "properties": {
            "Assembled": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "kinds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Text",
            "Reasoning",
            "Plan"
          ],
          "properties": {
            "Text": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "Reasoning": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "Plan": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "completions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Complete",
            "Interrupted",
            "Error",
            "Finished"
          ],
          "properties": {
            "Complete": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "Interrupted": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "Error": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "Finished": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      }
    },
    "toolOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "sources",
        "outcomes"
      ],
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Source",
            "Outcome"
          ],
          "properties": {
            "Source": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "Outcome": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "BatchSummary"
          ],
          "properties": {
            "BatchSummary": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Succeeded",
            "Unknown"
          ],
          "properties": {
            "Succeeded": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "Unknown": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      }
    },
    "notificationThreadWrapperType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "codexRateLimitReachedTimeWindow": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "modelSentinels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountDefaultModel",
        "effortAuto"
      ],
      "properties": {
        "accountDefaultModel": {
          "type": "string",
          "minLength": 1
        },
        "effortAuto": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "notificationFields": {
      "description": "Payload keys the worker writes onto a notification and the browser reads back, keyed by the identifier both languages spell. The contract CHOOSES the wire key; the Go struct tags follow it, and TestOptionChangeEntryTagsComeFromTheContract holds them to it. The pattern is therefore snake_case only, the same one messageMetadataFields uses: a table that admitted two conventions let each new entry pick either, and a mixed payload made a reader guess which one a key takes.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "backgroundTaskStatusTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Unspecified",
        "Pending",
        "Running",
        "Paused",
        "Succeeded",
        "Failed",
        "Stopped",
        "Interrupted",
        "EndedWithUnknownOutcome"
      ],
      "properties": {
        "Unspecified": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*)?$"
        },
        "Pending": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*)?$"
        },
        "Running": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*)?$"
        },
        "Paused": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*)?$"
        },
        "Succeeded": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*)?$"
        },
        "Failed": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*)?$"
        },
        "Stopped": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*)?$"
        },
        "Interrupted": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*)?$"
        },
        "EndedWithUnknownOutcome": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*)?$"
        }
      }
    }
  }
}
