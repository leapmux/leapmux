{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-vocab.schema.json",
  "title": "worker wire vocabulary contract",
  "description": "Notification-type tokens, the notification-thread wrapper discriminator, the Codex time-window rate-limit token, and the model sentinels. The generator checks workerAuthoredNotificationTypes names keys of notificationTypes and that the tokens are unique. It also holds the session goal's two payload vocabularies: goalStatusTokens (the neutral status the agents row stores, whose empty token means no goal) and goalTransitions (what a goal change did).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_readme",
    "notificationTypes",
    "goalStatusTokens",
    "goalTransitions",
    "workerAuthoredNotificationTypes",
    "assembledMessage",
    "notificationThreadWrapperType",
    "messageMetadataFields",
    "messageSupplementFields",
    "rpcMethods",
    "codexRateLimitReachedTimeWindow",
    "modelSentinels"
  ],
  "properties": {
    "messageSupplementFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Provider", "Metadata"],
      "properties": {
        "Provider": { "type": "string", "minLength": 1 },
        "Metadata": { "type": "string", "minLength": 1 }
      }
    },
    "messageMetadataFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DurationMs", "ToolUses"],
      "properties": {
        "DurationMs": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "ToolUses": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      }
    },
    "rpcMethods": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Z][A-Za-z0-9]*$" },
      "additionalProperties": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
    },
    "_readme": {
      "type": "string",
      "minLength": 1
    },
    "notificationTypes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "goalStatusTokens": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z][a-z0-9_]*)?$"
      }
    },
    "goalTransitions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "workerAuthoredNotificationTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      }
    },
    "assembledMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "types", "kinds", "completions"],
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Type", "Kind", "Text", "Completion"],
          "properties": {
            "Type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "Kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "Text": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "Completion": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          }
        },
        "types": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Assembled"],
          "properties": { "Assembled": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
        },
        "kinds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Text", "Reasoning", "Plan"],
          "properties": {
            "Text": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "Reasoning": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "Plan": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          }
        },
        "completions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Complete", "Interrupted", "Error"],
          "properties": {
            "Complete": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "Interrupted": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "Error": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          }
        }
      }
    },
    "notificationThreadWrapperType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "codexRateLimitReachedTimeWindow": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "modelSentinels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountDefaultModel",
        "effortAuto"
      ],
      "properties": {
        "accountDefaultModel": {
          "type": "string",
          "minLength": 1
        },
        "effortAuto": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
