{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-vocab.schema.json",
  "title": "worker wire vocabulary contract",
  "description": "Notification-type tokens, the notification-thread wrapper discriminator, the Codex time-window rate-limit token, and the model sentinels. The generator checks workerAuthoredNotificationTypes names keys of notificationTypes and that the tokens are unique. It also holds the session goal's two payload vocabularies: goalStatusTokens (the neutral status the agents row stores, whose empty token means no goal) and goalTransitions (what a goal change did).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_readme",
    "notificationTypes",
    "goalStatusTokens",
    "goalTransitions",
    "workerAuthoredNotificationTypes",
    "assembledMessage",
    "notificationThreadWrapperType",
    "codexRateLimitReachedTimeWindow",
    "modelSentinels"
  ],
  "properties": {
    "_readme": {
      "type": "string",
      "minLength": 1
    },
    "notificationTypes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "goalStatusTokens": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z][a-z0-9_]*)?$"
      }
    },
    "goalTransitions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "workerAuthoredNotificationTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      }
    },
    "assembledMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Type",
        "KindText",
        "KindReasoning",
        "KindPlan",
        "CompletionComplete",
        "CompletionInterrupted",
        "CompletionError",
        "MetadataKey"
      ],
      "properties": {
        "Type": { "type": "string", "const": "assembled_message" },
        "KindText": { "type": "string", "const": "text" },
        "KindReasoning": { "type": "string", "const": "reasoning" },
        "KindPlan": { "type": "string", "const": "plan" },
        "CompletionComplete": { "type": "string", "const": "complete" },
        "CompletionInterrupted": { "type": "string", "const": "interrupted" },
        "CompletionError": { "type": "string", "const": "error" },
        "MetadataKey": { "type": "string", "const": "_leapmux" }
      }
    },
    "notificationThreadWrapperType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "codexRateLimitReachedTimeWindow": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "modelSentinels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountDefaultModel",
        "effortAuto"
      ],
      "properties": {
        "accountDefaultModel": {
          "type": "string",
          "minLength": 1
        },
        "effortAuto": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
