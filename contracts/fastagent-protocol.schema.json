{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastagent-protocol.schema.json",
  "title": "Fast Agent integration vocabulary",
  "description": "Native Fast Agent modes and LeapMux option IDs shared by the worker and browser. Each table maps a PascalCase identifier to its string value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_readme",
    "modes",
    "defaultMode",
    "options",
    "tools",
    "archive",
    "audioMimeTypes"
  ],
  "$defs": {
    "table": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "unread": {
      "description": "The per-key exemptions this domain states. `contractsAreConsumed.test.mjs` holds every KEY of a table to a reader on each side the table declares. A key one side genuinely never reads states that here.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sides",
            "why"
          ],
          "properties": {
            "sides": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "go",
                  "ts"
                ]
              }
            },
            "why": {
              "type": "string",
              "minLength": 31
            }
          }
        }
      }
    }
  },
  "properties": {
    "_readme": {
      "type": "string",
      "minLength": 1
    },
    "_unread": {
      "$ref": "#/$defs/unread"
    },
    "modes": {
      "$ref": "#/$defs/table"
    },
    "defaultMode": {
      "description": "The key in `modes` a fresh fast-agent session runs on. A key, not a literal, so it cannot name a mode the table does not carry -- the generator checks the membership.",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "options": {
      "$ref": "#/$defs/table"
    },
    "tools": {
      "$ref": "#/$defs/table"
    },
    "archive": {
      "$ref": "#/$defs/table"
    },
    "audioMimeTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      }
    }
  }
}
