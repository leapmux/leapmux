{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "branch_name_conformance.schema.json",
  "title": "git branch-name conformance corpus",
  "description": "Shared by backend/internal/worker/gitutil/branch_name_conformance_test.go and frontend/src/lib/validate.test.ts. `refusal` is a stable token, not a message, because the two languages word their refusals differently.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_readme", "cases"],
  "properties": {
    "_readme": { "$ref": "#/$defs/readme" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "valid", "refusal", "why"],
        "properties": {
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": { "text": { "type": "string" } }
          },
          "valid": { "type": "boolean" },
          "refusal": { "type": "string" },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "readme": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    }
  }
}
