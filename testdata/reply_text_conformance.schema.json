{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reply_text_conformance.schema.json",
  "title": "reply text conformance corpus",
  "description": "Shared by agenttest.RunReplyTextConformance, which each provider package of the Worker runs over its own cases, and frontend/src/components/chat/replyTextConformance.test.ts, which replays every case through the browser's row extraction.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_readme", "cases"],
  "properties": {
    "_readme": { "$ref": "#/$defs/readme" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "provider", "content", "reply"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "pattern": "^AGENT_PROVIDER_[A-Z0-9_]+$" },
          "content": {},
          "supplemental": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider": {},
              "metadata": {}
            }
          },
          "agent_session_id": { "type": "string", "minLength": 1 },
          "assembled_kind": { "type": "string", "enum": ["text", "reasoning", "plan"] },
          "reply": { "type": ["string", "null"] },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "readme": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    }
  }
}
