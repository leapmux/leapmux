{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hlc_wire_corpus.schema.json",
  "title": "resume-cursor HLC wire-format corpus",
  "description": "Shared by backend/channelwire/wire_test.go and frontend/src/lib/crdt/hlc.test.ts. The wire form is '<physical>.<logical>.<client_id>'; the three parsed fields are present only when ok is true (int64 fields as strings, protojson-style).",
  "type": "object",
  "additionalProperties": false,
  "required": ["_readme", "cases"],
  "properties": {
    "_readme": { "$ref": "#/$defs/readme" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["raw", "ok"],
        "properties": {
          "raw": { "type": "string" },
          "ok": { "type": "boolean" },
          "physical": { "type": "string", "pattern": "^[0-9]+$" },
          "logical": { "type": "string", "pattern": "^[0-9]+$" },
          "clientId": { "type": "string" },
          "_note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "readme": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    }
  }
}
