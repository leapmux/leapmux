{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zcode_tool_supplement_conformance.schema.json",
  "title": "ZCode retained-tool supplement conformance",
  "type": "object",
  "additionalProperties": false,
  "required": ["_readme", "cases"],
  "properties": {
    "_readme": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "original", "record", "supplement", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "original": { "type": "object" },
          "record": {
            "type": "object",
            "additionalProperties": false,
            "required": ["native", "artifacts"],
            "properties": {
              "native": { "type": "object" },
              "artifacts": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          },
          "supplement": { "type": "object" },
          "expected": { "type": "object" }
        }
      }
    }
  }
}
