{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cursor_extension_conformance.schema.json",
  "title": "Cursor extension resolve conformance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_readme",
    "cases"
  ],
  "properties": {
    "_readme": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "original",
          "supplement",
          "resolved",
          "extension"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "original": {
            "type": "object"
          },
          "supplement": {
            "type": "object"
          },
          "resolved": {
            "type": "object"
          },
          "extension": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  }
}
