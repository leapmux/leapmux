{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opencode_form_prompt_conformance.schema.json",
  "title": "OpenCode form prompt conformance",
  "description": "Shared by TestReadControlRequest_FormPromptConformance (backend/internal/worker/agent/providers/opencode), which reads each payload through the OpenCode provider and requires the stated prompt, and frontend/src/components/chat/providers/opencode/formPromptConformance.test.ts, which fills the form of each prompt with the shared form and requires the stated visible fields and answers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_readme", "cases"],
  "properties": {
    "_readme": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "payload", "prompt"],
        "anyOf": [
          { "properties": { "visible": true }, "required": ["visible"] },
          { "properties": { "reads": true }, "required": ["reads"] }
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "payload": {
            "description": "A stored form.created control request, as the native control registry publishes it.",
            "type": "object",
            "required": ["type", "data"],
            "properties": {
              "type": { "const": "form.created" },
              "data": { "type": "object" }
            }
          },
          "prompt": {
            "description": "A leapmux.v1.ControlPrompt in protojson, as agent.ReadControlPrompt reads the payload.",
            "type": "object",
            "required": ["elicitation"],
            "properties": {
              "elicitation": { "type": "object" }
            }
          },
          "visible": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["answers", "fields"],
              "properties": {
                "answers": { "$ref": "#/$defs/answers" },
                "fields": {
                  "description": "The keys of the fields that the form shows for the answers, in order.",
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "reads": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["answers"],
              "oneOf": [
                { "properties": { "content": true }, "required": ["content"] },
                { "properties": { "error": true }, "required": ["error"] }
              ],
              "properties": {
                "answers": { "$ref": "#/$defs/answers" },
                "content": {
                  "description": "The content that the form sends for the answers.",
                  "type": "object"
                },
                "error": {
                  "description": "The error that the form states for the answers, or true for any error.",
                  "oneOf": [
                    { "type": "string", "minLength": 1 },
                    { "const": true }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "answers": {
      "description": "The text that the user entered in each field, by the key of the field.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
