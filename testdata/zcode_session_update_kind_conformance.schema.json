{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zcode_session_update_kind_conformance.schema.json",
  "title": "ZCode session.updated kind conformance",
  "type": "object",
  "additionalProperties": false,
  "required": ["_readme", "cases"],
  "properties": {
    "_readme": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "payload", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "payload": { "type": "object" },
          "kind": {
            "enum": [
              "drop",
              "networkStatus",
              "backgroundTask",
              "subagent",
              "modelResponse",
              "goalVerification",
              "goalChange",
              "modeChange",
              "compaction",
              "microcompact",
              "modelSelected",
              "hookRun",
              "hookAdmission",
              "steerDiscarded"
            ]
          }
        }
      }
    }
  }
}
