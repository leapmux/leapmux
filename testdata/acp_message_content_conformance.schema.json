{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acp_message_content_conformance.schema.json",
  "title": "Agent Client Protocol supplement resolve conformance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_readme",
    "cases"
  ],
  "properties": {
    "_readme": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "original",
          "supplemental",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "original": {
            "type": "object"
          },
          "supplemental": {},
          "expected": {
            "type": "object"
          }
        }
      }
    }
  }
}
