{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "title_cleaning_conformance.schema.json",
  "title": "tab-title cleaning conformance corpus",
  "description": "Shared by backend/util/validate/name_test.go (title cleaning cases) and frontend/src/lib/validate.test.ts. Both `input` and `cleaned` wrap the text in a {text} object so whitespace-only and empty cases stay visible in the file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_readme", "cases"],
  "properties": {
    "_readme": { "$ref": "#/$defs/readme" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "cleaned", "why"],
        "properties": {
          "input": { "$ref": "#/$defs/builtText" },
          "cleaned": { "$ref": "#/$defs/builtText" },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "readme": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "builtText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "repeat": { "type": "integer", "minimum": 2 },
        "tail": { "type": "string" }
      }
    }
  }
}
