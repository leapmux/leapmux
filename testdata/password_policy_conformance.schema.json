{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "password_policy_conformance.schema.json",
  "title": "password policy conformance corpus",
  "description": "Shared by backend/util/validate/password_test.go and frontend/src/lib/validate.test.ts. `refusal` is a stable token, not a message. The optional `repeat` (integer >= 2) asks the case to build `password` repeated N times.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_readme", "cases"],
  "properties": {
    "_readme": { "$ref": "#/$defs/readme" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["password", "valid", "refusal", "why"],
        "properties": {
          "password": { "type": "string" },
          "repeat": { "type": "integer", "minimum": 2 },
          "valid": { "type": "boolean" },
          "refusal": { "type": "string" },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "readme": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    }
  }
}
