{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tunnel_bind_addr_conformance.schema.json",
  "title": "tunnel bind-address validation corpus",
  "description": "Shared by desktop/go/tunnel_test.go and frontend/src/lib/ipAddress.test.ts. The sidecar's validateTunnelBindAddr is the enforcement point; the browser mirror exists so the Add-Tunnel dialog can explain a refusal at the field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_readme", "cases"],
  "properties": {
    "_readme": { "$ref": "#/$defs/readme" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "normalized", "loopback", "why"],
        "properties": {
          "input": { "type": "string" },
          "normalized": { "type": "string" },
          "loopback": { "type": "boolean" },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "readme": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    }
  }
}
