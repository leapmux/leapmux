{
  "_readme": "The Agent Client Protocol supplement resolve, replayed by BOTH implementations: `resolveACPMessageContent` in the Go worker and `resolveACPMessage` in the browser plugin. Six providers share that resolve, so one divergence between the two copies shows a different row to the reader than the worker's own semantic extractors saw. Each case gives the frame the agent sent, the envelope the worker stored beside it, and the object both sides must produce. The key names come from contracts/acp-protocol.json; these cases pin the BEHAVIOUR the names carry.",
  "cases": [
    {
      "name": "a later update fills every request field the opener omitted",
      "original": {
        "sessionUpdate": "tool_call_update",
        "toolCallId": "call-1",
        "status": "completed"
      },
      "supplemental": {
        "sessionUpdate": "tool_call_update",
        "toolCallId": "call-1",
        "status": "completed",
        "title": "Read file",
        "kind": "read",
        "rawInput": {
          "path": "/project/main.go"
        },
        "locations": [
          {
            "path": "/project/main.go"
          }
        ]
      },
      "expected": {
        "sessionUpdate": "tool_call_update",
        "toolCallId": "call-1",
        "status": "completed",
        "title": "Read file",
        "kind": "read",
        "rawInput": {
          "path": "/project/main.go"
        },
        "locations": [
          {
            "path": "/project/main.go"
          }
        ]
      }
    },
    {
      "name": "rawInput merges into the opener's own arguments",
      "original": {
        "sessionUpdate": "tool_call_update",
        "toolCallId": "call-1",
        "status": "completed",
        "rawInput": {
          "path": "/project/main.go",
          "limit": 20
        }
      },
      "supplemental": {
        "sessionUpdate": "tool_call_update",
        "toolCallId": "call-1",
        "status": "completed",
        "rawInput": {
          "offset": 5
        }
      },
      "expected": {
        "sessionUpdate": "tool_call_update",
        "toolCallId": "call-1",
        "status": "completed",
        "rawInput": {
          "path": "/project/main.go",
          "limit": 20,
          "offset": 5
        }
      }
    },
    {
