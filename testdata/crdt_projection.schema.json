{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crdt_projection.schema.json",
  "title": "CRDT merge + tab-projection conformance corpus",
  "description": "Shared shape of testdata/crdt_projection_conformance.json (hand-curated) and testdata/crdt_projection_corpus.json (generated by `task generate-conformance-corpus`). Ops are protojson of leapmux.v1.CrdtOp reduced to canonicalHlc plus exactly one body message (int64s as strings). Enum names, field names, and the exactly-one-register-write property mirror proto/leapmux/v1/user_ops.proto -- the property-count bounds are what enforce 'exactly one field' on each register op.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_readme", "userId", "cases"],
  "properties": {
    "_readme": { "$ref": "#/$defs/readme" },
    "userId": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "why", "ops", "expect"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "ops": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["canonicalHlc"],
              "minProperties": 2,
              "maxProperties": 2,
              "properties": {
                "canonicalHlc": { "$ref": "#/$defs/hlc" },
                "setNodeRegister": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["nodeId"],
                  "minProperties": 2,
                  "maxProperties": 2,
                  "properties": {
                    "nodeId": { "type": "string" },
                    "kind": { "$ref": "#/$defs/nodeKind" },
                    "parentId": { "type": "string" },
                    "position": { "type": "string" },
                    "direction": { "$ref": "#/$defs/splitDirection" },
                    "ratios": { "$ref": "#/$defs/doubleList" },
                    "rows": { "type": "integer", "minimum": 1 },
                    "cols": { "type": "integer", "minimum": 1 },
                    "rowRatios": { "$ref": "#/$defs/doubleList" },
                    "colRatios": { "$ref": "#/$defs/doubleList" }
                  }
                },
                "tombstoneNode": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["nodeId"],
                  "maxProperties": 1,
                  "properties": { "nodeId": { "type": "string" } }
                },
                "setTabRegister": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["tabType", "tabId"],
                  "minProperties": 3,
                  "maxProperties": 3,
                  "properties": {
                    "tabType": { "$ref": "#/$defs/tabType" },
                    "tabId": { "type": "string" },
                    "tileId": { "type": "string" },
                    "position": { "type": "string" },
                    "workerId": { "type": "string" },
                    "displayMode": { "type": "integer" },
                    "fileViewMode": { "type": "integer" },
                    "fileDiffBase": { "type": "string" }
                  }
                },
                "tombstoneTab": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["tabType", "tabId"],
                  "maxProperties": 2,
                  "properties": {
                    "tabType": { "$ref": "#/$defs/tabType" },
                    "tabId": { "type": "string" }
                  }
                },
                "setFloatingWindowRegister": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["windowId"],
                  "minProperties": 2,
                  "maxProperties": 2,
                  "properties": {
                    "windowId": { "type": "string" },
                    "workspaceId": { "type": "string" },
                    "x": { "type": "number" },
                    "y": { "type": "number" },
                    "width": { "type": "number" },
                    "height": { "type": "number" },
                    "opacity": { "type": "number" },
                    "rootNodeId": { "type": "string" }
                  }
                },
                "tombstoneFloatingWindow": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["windowId"],
                  "maxProperties": 1,
                  "properties": { "windowId": { "type": "string" } }
                },
                "setWorkspaceRootNode": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["workspaceId", "rootNodeId"],
                  "maxProperties": 2,
                  "properties": {
                    "workspaceId": { "type": "string" },
                    "rootNodeId": { "type": "string" }
                  }
                },
                "setWorkspaceRegister": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["workspaceId"],
                  "maxProperties": 1,
                  "properties": { "workspaceId": { "type": "string" } }
                },
                "tombstoneWorkspace": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["workspaceId"],
                  "maxProperties": 1,
                  "properties": { "workspaceId": { "type": "string" } }
                }
              }
            }
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owned", "rendered"],
            "properties": {
              "owned": { "type": "array", "items": { "$ref": "#/$defs/tabSummary" } },
              "rendered": { "type": "array", "items": { "$ref": "#/$defs/tabSummary" } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "readme": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "hlc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical", "logical", "clientId"],
      "properties": {
        "physical": { "type": "string", "pattern": "^[0-9]+$" },
        "logical": { "type": "string", "pattern": "^[0-9]+$" },
        "clientId": { "type": "string", "minLength": 1 }
      }
    },
    "tabType": {
      "enum": ["TAB_TYPE_AGENT", "TAB_TYPE_TERMINAL", "TAB_TYPE_FILE"]
    },
    "nodeKind": {
      "enum": ["NODE_KIND_LEAF", "NODE_KIND_SPLIT", "NODE_KIND_GRID"]
    },
    "splitDirection": {
      "enum": ["SPLIT_DIRECTION_HORIZONTAL", "SPLIT_DIRECTION_VERTICAL"]
    },
    "doubleList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values"],
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "tabSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tabType", "tabId", "workspaceId", "tileId", "workerId", "position"],
      "properties": {
        "tabType": { "$ref": "#/$defs/tabType" },
        "tabId": { "type": "string" },
        "workspaceId": { "type": "string" },
        "tileId": { "type": "string" },
        "workerId": { "type": "string" },
        "position": { "type": "string" }
      }
    }
  }
}
