{
  "_readme": "The Codex joined-output resolve, replayed by BOTH implementations: `codexProvider.ResolveProviderData` in the Go worker and `resolveCodexMessage` in the browser plugin. Codex fills `aggregatedOutput` only on a COMPLETED item, so a turn that ends first leaves the started item with no output and the worker's join is the only copy. A divergence between the two copies draws a retained command row with its output missing and states nothing about why. Each case gives the frame Codex sent, the envelope the worker stored beside it, and the object both sides must produce. The key names come from contracts/codex-protocol.json; these cases pin the BEHAVIOUR the names carry.",
  "cases": [
    {
      "name": "the joined output lands on the item it names",
      "original": {
        "threadId": "thread-1",
        "item": {
          "id": "item-1",
          "type": "commandExecution",
          "command": "ls -1",
          "status": "in_progress"
        }
      },
      "supplemental": {
        "itemId": "item-1",
        "itemType": "commandExecution",
        "aggregatedOutput": "a.go\nb.go\n"
      },
      "expected": {
        "threadId": "thread-1",
        "item": {
          "id": "item-1",
          "type": "commandExecution",
          "command": "ls -1",
          "status": "in_progress",
          "aggregatedOutput": "a.go\nb.go\n"
        }
      }
    },
    {
      "name": "a joined output replaces the output the item already carries",
      "original": {
        "threadId": "thread-1",
        "item": {
          "id": "item-1",
          "type": "commandExecution",
          "aggregatedOutput": "partial"
        }
      },
      "supplemental": {
        "itemId": "item-1",
        "itemType": "commandExecution",
        "aggregatedOutput": "complete"
      },
      "expected": {
        "threadId": "thread-1",
        "item": {
          "id": "item-1",
          "type": "commandExecution",
          "aggregatedOutput": "complete"
        }
      }
    },
    {
