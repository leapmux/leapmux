{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "short-video.schema.json",
  "title": "Portable MP4 attachment fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_readme",
    "mimeType",
    "width",
    "height",
    "frameCount",
    "dataBase64"
  ],
  "properties": {
    "_readme": {
      "type": "string",
      "minLength": 1
    },
    "mimeType": {
      "const": "video/mp4"
    },
    "width": {
      "type": "integer",
      "const": 16
    },
    "height": {
      "type": "integer",
      "const": 16
    },
    "frameCount": {
      "type": "integer",
      "const": 2
    },
    "dataBase64": {
      "type": "string",
      "minLength": 1000,
      "maxLength": 4096,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  }
}
