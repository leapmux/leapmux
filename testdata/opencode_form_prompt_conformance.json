              { "key": "count", "type": "integer", "required": true, "when": [{ "key": "details", "op": "neq", "value": "" }] },
              { "key": "hidden", "type": "integer", "hidden": true, "default": 0 }
            ]
          }
        }
      },
      "prompt": {"editorPurpose":"CONTROL_EDITOR_PURPOSE_NONE","elicitation":{"mode":"form","schemaJson":"{\"type\":\"object\",\"properties\":{\"enabled\":{\"default\":false,\"type\":\"boolean\"},\"details\":{\"type\":\"string\",\"minLength\":1},\"count\":{\"type\":\"integer\"},\"hidden\":{\"default\":0,\"type\":\"integer\"}},\"required\":[\"details\",\"count\"]}","fieldRules":[{"key":"enabled"},{"conditions":[{"comparison":"ELICITATION_FIELD_COMPARISON_EQUAL","field":"enabled","valueJson":"true"}],"key":"details"},{"conditions":[{"comparison":"ELICITATION_FIELD_COMPARISON_NOT_EQUAL","field":"details","valueJson":"\"\""}],"key":"count"},{"hidden":true,"key":"hidden"}]}},
