{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zcode_model_response_conformance.schema.json",
  "title": "ZCode model-response main-reply conformance",
  "type": "object",
  "additionalProperties": false,
  "required": ["_readme", "cases"],
  "properties": {
    "_readme": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "payload", "isMainReply"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "payload": { "type": "object" },
          "isMainReply": { "type": "boolean" }
        }
      }
    }
  }
}
