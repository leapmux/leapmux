        "payload": {
          "kind": "scheduled",
          "toolCallId": "call",
          "input": {
            "plan": "",
            "enabled": false,
            "count": 0,
            "optional": null
          }
        }
      },
      "supplemental": {
        "type": "tool.updated",
        "payload": {
          "kind": "scheduled",
          "toolCallId": "call",
          "input": {
            "plan": "changed",
            "enabled": true,
            "count": 1,
            "optional": "changed",
            "newField": "recovered"
          }
        }
      },
      "expected": {
        "type": "tool.updated",
        "payload": {
          "kind": "scheduled",
          "toolCallId": "call",
          "input": {
            "plan": "",
            "enabled": false,
            "count": 0,
            "optional": null,
            "newField": "recovered"
          }
        }
      }
