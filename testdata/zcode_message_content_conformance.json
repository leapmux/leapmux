      "name": "partial plan input",
      "original": {
        "type": "tool.updated",
        "payload": {
          "kind": "scheduled",
          "toolCallId": "call",
          "input": {
            "allowedPrompts": []
          }
        }
      },
      "supplemental": {
        "type": "tool.updated",
        "payload": {
          "kind": "scheduled",
          "toolCallId": "call",
          "input": {
            "plan": "# Stored plan",
            "allowedPrompts": [
              "changed"
            ]
          }
        }
      },
      "expected": {
        "type": "tool.updated",
        "payload": {
          "kind": "scheduled",
          "toolCallId": "call",
          "input": {
            "plan": "# Stored plan",
            "allowedPrompts": []
          }
        }
      }
