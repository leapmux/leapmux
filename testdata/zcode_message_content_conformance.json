    {
      "name": "nested input remains authoritative",
      "original": {
        "type": "tool.updated",
        "payload": {
          "kind": "scheduled",
          "toolCallId": "call",
          "input": {
            "options": {
              "original": true
            }
          }
        }
      },
      "supplemental": {
        "type": "tool.updated",
        "payload": {
          "kind": "scheduled",
          "toolCallId": "call",
          "input": {
            "options": {
              "added": true
            },
            "plan": "# Plan"
          }
        }
      },
      "expected": {
        "type": "tool.updated",
        "payload": {
          "kind": "scheduled",
          "toolCallId": "call",
          "input": {
            "options": {
              "original": true
            },
            "plan": "# Plan"
          }
        }
      }
    },
    {
      "name": "own property keys",
      "original": {
        "type": "tool.updated",
        "payload": {
          "kind": "scheduled",
          "toolCallId": "call",
          "input": {
            "constructor": "original"
          }
        }
      },
      "supplemental": {
        "type": "tool.updated",
        "payload": {
          "kind": "scheduled",
          "toolCallId": "call",
          "input": {
            "constructor": "changed",
            "__proto__": {
              "keep": true
            },
            "toString": "native"
          }
        }
      },
      "expected": {
        "type": "tool.updated",
        "payload": {
          "kind": "scheduled",
          "toolCallId": "call",
          "input": {
            "constructor": "original",
            "__proto__": {
