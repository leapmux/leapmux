{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex_approval_answer_conformance.schema.json",
  "title": "Codex permission request answer conformance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_readme",
    "cases"
  ],
  "properties": {
    "_readme": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "request",
          "standingResult"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "request": {
            "description": "The JSON-RPC request that Codex sends to the client.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "jsonrpc",
              "id",
              "method",
              "params"
            ],
            "properties": {
              "jsonrpc": {
                "const": "2.0"
              },
              "id": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "params": {
                "type": "object"
              }
            }
          },
          "allowResult": {
            "type": "object"
          },
          "standingResult": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  }
}
