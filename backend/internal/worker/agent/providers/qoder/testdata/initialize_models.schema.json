{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recorded Qoder initialize model catalog",
  "type": "object",
  "required": [
    "models"
  ],
  "additionalProperties": false,
  "properties": {
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "value",
          "isEnabled"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "isEnabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
