{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ask_form_context_conformance.schema.json",
  "title": "Native Oh My Pi field question and context cases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_readme",
    "cases"
  ],
  "properties": {
    "_readme": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "html",
          "questions"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "html": {
            "type": "string",
            "minLength": 1
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "question",
                "context"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "context": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
